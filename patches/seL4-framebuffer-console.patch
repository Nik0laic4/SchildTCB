+    uint32_t pitch = boot_state.fb_info.pitch / 4; /* pixels per scanline */
+    uint32_t cols = boot_state.fb_info.width / 8;
+    uint32_t rows = boot_state.fb_info.height / 16;
+    int g, x, y;
+
+    if (c == '\r') {
+        schild_fb_col = 0;
+        return;
+    }
+    if (c == '\n') {
+        schild_fb_col = 0;
+        schild_fb_row++;
+    } else {
+        g = (c >= 0x20 && c < 0x7f) ? (int)(c - 0x20) : 0;
+        for (y = 0; y < 16; y++) {
+            unsigned char row = schild_font8x16[g][y];
+            /* 64-bit glyph stores: pack 2 pixels per word (uncached fb). */
